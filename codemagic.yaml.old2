workflows:
  ios-capacitor-build:
    name: iOS Capacitor Build
    max_build_duration: 60
    instance_type: mac_mini_m2

    integrations:
      app_store_connect: A7Y6Q4TYBX

    environment:
      ios_signing:
        distribution_type: app_store
        bundle_identifier: com.echoreach.fristenwaechter

      vars:
        XCODE_PROJECT: "ios/App/App.xcodeproj"
        XCODE_SCHEME: "App"
        node: latest
        xcode: latest

    triggering:
      events:
        - push
      branch_patterns:
        - pattern: main
          include: true

    scripts:
      - name: Install npm dependencies
        script: |
          npm install

      - name: Prepare static PWA for Capacitor
        script: |
          mkdir -p www
          cp -R index.html www/
          cp -R app.js www/
          cp -R styles.css www/
          # Falls du weitere Dateien hast:
          # cp -R assets www/

      - name: Sync Capacitor
        script: |
          npx cap sync ios

      - name: Build iOS project
        script: |
          xcodebuild \
            -project "$XCODE_PROJECT" \
            -scheme "$XCODE_SCHEME" \
            -configuration Release \
            -archivePath build/App.xcarchive \
            archive

      - name: Export IPA
        script: |
          xcodebuild \
            -exportArchive \
            -archivePath build/App.xcarchive \
            -exportOptionsPlist exportOptions.plist \
            -exportPath build
